{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monitor",
  "version": "0.11.0-alpha.1",
  "identifier": "io.monitor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --workspace @monitor/frontend",
    "beforeBuildCommand": "npm run build --workspace @monitor/frontend",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Monitor — Sua central de operação",
        "width": 1440,
        "height": 960,
        "minWidth": 800,
        "minHeight": 650,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "externalBin": [
      "binaries/monitor-backend"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "shortDescription": "Central de operação pessoal com IA local",
    "windows": {
      "wix": {
        "version": "0.11.0.1"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "PortugueseBR"
        ],
        "template": "windows/installer.nsi",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2NUM0NDE2RjE1MTE3RDcKUldUWEYxSHhGa1JjcHBxdWRSdlk4QnNLVEc0U05uamlyZkVySVpqVURrNUpoamlBL0ZhUWZ1R3cK",
      "endpoints": [
        "https://github.com/pbrmarcos/monitor/releases/download/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
